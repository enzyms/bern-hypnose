{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "bern-hypnose-podcast-audio",
    "main": "src/index.ts",
    "compatibility_date": "2026-11-01",
    "workers_dev": true,
    "observability": { "enabled": true },
    "r2_buckets": [
        {
            "binding": "AUDIO",
            "bucket_name": "bern-hypnose-podcast"
        }
    ]
}
